# Database connection URL (asyncpg DSN for Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pm_screener

# Snapshot loop configuration
POLL_INTERVAL_SECONDS=300

# Rate limits (requests per second)
KALSHI_RATE_LIMIT_RPS=10.0
POLYMARKET_RATE_LIMIT_RPS=10.0

# Logging
LOG_LEVEL=INFO
